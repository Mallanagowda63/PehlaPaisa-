<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: dark night-shelf background with the
         glass icon (no white tile), matching the app's own loading screen. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/pp_night</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/pp_night</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/pp_night</item>
    </style>
</resources>
